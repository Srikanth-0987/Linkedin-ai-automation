# LinkedIn Developer App Credentials (from developer.linkedin.com)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_MEMBER_ID=
LINKEDIN_API_VERSION=202601

# AI Provider Configuration (Default: ollama, Options: ollama, groq, gemini)
AI_PROVIDER=ollama

# Local Ollama Configuration (₹0 Budget, 100% Free Offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Groq Cloud Configuration (Free Tier, Fast Inference)
# Models: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API (Optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Mandatory Safety Settings (Defaults)
DRY_RUN=true
PUBLISH_ENABLED=false
REQUIRE_APPROVAL=true

# Database
DATABASE_PATH=linkedin_automation.db

# AI & Technology Trend Intelligence Engine - Configurable Scoring Weights (Default sum = 100)
WEIGHT_RECENCY=25.0
WEIGHT_CREDIBILITY=20.0
WEIGHT_SIGNIFICANCE=20.0
WEIGHT_COVERAGE=15.0
WEIGHT_RELEVANCE=15.0
WEIGHT_NOVELTY=5.0

# Optional custom source registry file (JSON)
# SOURCES_CONFIG_FILE=sources.json
